{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/apply/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/lookup",
      "destination": "/index.html"
    },
    {
      "source": "/control/:path*",
      "destination": "/index.html"
    }
  ]
}
